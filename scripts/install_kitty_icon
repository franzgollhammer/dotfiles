#!/bin/bash

# Apply the alternative kitty icon from https://github.com/DinkDonk/kitty-icon
# (vendored in kitty/icon/).
#
# Two levels, because macOS resolves an app's icon from two different places:
#
#   default    kitty reads ~/.config/kitty/kitty.app.icns (linked by
#              build_symlinks) on every start and writes it onto the app as a
#              Finder custom icon — an `Icon` file with a resource fork next to
#              Contents/. That covers Finder and the Dock.
#   --bundle   also overwrite Contents/Resources/<CFBundleIconFile>.icns.
#              Needed for desktop NOTIFICATIONS: usernoted renders the banner
#              with the icon from the bundle and ignores the Finder custom icon.
#              Undone by every kitty update, so re-run it then.
#
# No ad-hoc re-sign here. It cannot succeed: codesign rejects the very Finder
# custom icon kitty writes for itself ("resource fork, Finder information, or
# similar detritus not allowed"), and kitty recreates it on the next start
# anyway. Replacing a resource leaves the Developer ID signature in place and
# only breaks `codesign --verify`; kitty still launches, having already cleared
# Gatekeeper on first run. Do not "fix" this with `codesign --force --sign -` —
# that trades a valid notarized signature for an ad-hoc one.
#
# Usage: install_kitty_icon [dark|light] [--bundle]

set -euo pipefail

DOTFILES_DIR="${DOTFILES:-$HOME/dev/dotfiles}"
APP="/Applications/kitty.app"
variant=dark
bundle=0

for arg in "$@"; do
  case $arg in
  dark | light) variant=$arg ;;
  --bundle) bundle=1 ;;
  *) echo "usage: $(basename "$0") [dark|light] [--bundle]" >&2; exit 2 ;;
  esac
done

ICON="$DOTFILES_DIR/kitty/icon/kitty-$variant.icns"
[ -f "$ICON" ] || { echo "missing $ICON"; exit 1; }

# What build_symlinks links; re-point it here so `install_kitty_icon light`
# switches variants without editing the symlink by hand.
mkdir -p "$HOME/.config/kitty"
ln -snfv "$ICON" "$HOME/.config/kitty/kitty.app.icns"

if [ "$bundle" -eq 1 ]; then
  [ -d "$APP" ] || { echo "kitty.app not found at /Applications"; exit 1; }

  # Read the icon file name out of Info.plist instead of guessing it.
  name=$(defaults read "$APP/Contents/Info" CFBundleIconFile 2>/dev/null || echo kitty)
  case $name in *.icns) ;; *) name="$name.icns" ;; esac
  TARGET="$APP/Contents/Resources/$name"

  [ -f "$TARGET" ] || { echo "no icon at $TARGET"; exit 1; }
  if cmp -s "$ICON" "$TARGET"; then
    echo "bundle icon already installed"
  else
    cp -v "$ICON" "$TARGET"
    # Drop the xattrs cp carried over, so nothing new lands in the bundle.
    xattr -c "$TARGET" 2>/dev/null || true
  fi
fi

# Flush the icon caches so Finder/Dock pick up the change.
rm -f /var/folders/*/*/*/com.apple.dock.iconcache 2>/dev/null || true
rm -rf /var/folders/*/*/*/com.apple.iconservices* 2>/dev/null || true
killall Dock

echo "kitty-$variant icon installed - restart kitty to see it"
