#!/bin/bash
# Usage: scr — choose an executable helper by number and run it.

scripts_dir="${SCRIPTS:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)}"
scripts=()
shopt -s nullglob dotglob
for script in "$scripts_dir"/*; do
  if [ -f "$script" ] && [ -x "$script" ]; then
    scripts+=("${script##*/}")
  fi
done
if [ "${#scripts[@]}" -eq 0 ]; then
  echo 'No executable helpers found.' >&2
  exit 1
fi

PS3='Helper number (Ctrl-D to cancel): '
select selected in "${scripts[@]}"; do
  [ -n "$selected" ] || continue
  exec "$scripts_dir/$selected"
done
exit 0
