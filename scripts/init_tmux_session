#!/bin/bash
# Usage: init_tmux_session — run the first executable project, home, or default .tmux_init.

INIT_FILE=".tmux_init"

if [[ -x "$INIT_FILE" ]]; then
  zsh ./$INIT_FILE
elif [[ -x "$HOME/$INIT_FILE" ]]; then
  zsh "$HOME/$INIT_FILE"
elif [[ -n "$DOTFILES" && -x "$DOTFILES/$INIT_FILE" ]]; then
  zsh "$DOTFILES/$INIT_FILE"
fi
