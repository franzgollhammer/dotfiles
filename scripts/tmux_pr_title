#!/bin/bash

# Usage: tmux_pr_title [dir]
# Rename the current tmux window to "<branch> #<pr-number>" for the PR of the
# worktree's branch (default: current directory). Falls back to
# "<repo> <branch>" when no PR exists. The repo name comes from origin, or from
# the main checkout's directory without a remote, because linked worktree
# directories are named after the branch. Requires tmux and an authenticated gh.

set -euo pipefail

dir="${1:-.}"

[ -n "${TMUX:-}" ] || { echo "tmux_pr_title: not inside tmux" >&2; exit 1; }

branch=$(git -C "$dir" symbolic-ref --quiet --short HEAD) || {
  echo "tmux_pr_title: not on a branch" >&2
  exit 1
}

number=$(cd "$dir" && gh pr view --json number --jq .number 2>/dev/null || true)

if [ -n "$number" ]; then
  title="$branch #$number"
else
  repo=$(git -C "$dir" remote get-url origin 2>/dev/null) ||
    repo=$(cd "$dir" && cd "$(git rev-parse --git-common-dir)" && pwd)
  repo="${repo%/}"
  repo="${repo%/.git}"
  repo="${repo%.git}"
  repo="${repo##*/}"
  repo="${repo##*:}"
  title="$repo $branch"
fi

tmux rename-window -t "${TMUX_PANE:-}" "$title"
