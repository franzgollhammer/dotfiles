#!/bin/bash
# wt_add - create a worktree at $GIT_WORKTREE_DIR/<repo>/<branch>
# Usage: wt_add            # fzf-pick a branch, or create a new one
#        wt_add <branch>   # check out that branch (creates it if needed)
#
# Prints the worktree path to stdout, everything else to stderr, so the
# `wta` shell function can cd into it.

set -euo pipefail

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

git rev-parse --git-dir > /dev/null 2>&1 || die "Not in a git repo"
[[ -n "${GIT_WORKTREE_DIR:-}" ]] || die "GIT_WORKTREE_DIR is not set"

# --git-common-dir points at the main repo's .git even from inside a worktree
REPO_ROOT=$(git rev-parse --path-format=absolute --git-common-dir)
REPO_ROOT=${REPO_ROOT%/}
REPO_ROOT=${REPO_ROOT%/.git}
WORKTREE_DIR="$GIT_WORKTREE_DIR/$(basename "$REPO_ROOT")"

branch="${1:-}"

if [[ -z "$branch" ]]; then
  branch=$(
    {
      echo "[+] New branch"
      git branch -a --format='%(refname:short)' \
        | sed 's|^origin/||' \
        | grep -v '^HEAD$' \
        | sort -u
    } | fzf --prompt="Branch: " --height=40% --border
  )
  [[ -n "$branch" ]] || exit 1

  if [[ "$branch" == "[+] New branch" ]]; then
    read -rp "Branch name: " branch
    [[ -n "$branch" ]] || die "No name given"
  fi
fi

# already checked out somewhere? hand back that path instead of failing
existing=$(git worktree list --porcelain | awk -v b="branch refs/heads/$branch" '
  /^worktree / { path = substr($0, 10) }
  $0 == b      { print path; exit }
')
if [[ -n "$existing" ]]; then
  printf 'Worktree already exists: %s\n' "$existing" >&2
  printf '%s\n' "$existing"
  exit 0
fi

wt_path="$WORKTREE_DIR/$branch"
mkdir -p "$(dirname "$wt_path")"

if git show-ref --verify --quiet "refs/heads/$branch"; then
  git worktree add "$wt_path" "$branch" >&2
elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
  git worktree add "$wt_path" -b "$branch" --track "origin/$branch" >&2
else
  git worktree add "$wt_path" -b "$branch" >&2
fi

printf '%s\n' "$wt_path"
