#!/bin/bash

# Enhanced tmux session management with better error handling

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# dev_projects prints "<label><TAB><path>"; fzf shows the label only.
SELECTED=$("$script_dir/dev_projects" \
  | fzf --delimiter=$'\t' --with-nth=1 --prompt="Select project: " --height=40% --border)

if [[ -z "$SELECTED" ]]; then
  echo "No directory selected"
  exit 0
fi
SELECTED_PROJECT=${SELECTED%%$'\t'*}
SELECTED_DIR=${DEV:-$HOME/dev}/${SELECTED#*$'\t'}

# Escape literal underscores and percent signs before using _ for the separator.
# This keeps a/b distinct from a_b and repo.name distinct from repo_name.
SELECTED_NAME=${SELECTED_PROJECT//%/%25}
SELECTED_NAME=${SELECTED_NAME//_/%5F}
SELECTED_NAME=${SELECTED_NAME//\//_}
SELECTED_NAME=${SELECTED_NAME//:/%3A}
SELECTED_NAME=${SELECTED_NAME//./%2E}
SELECTED_NAME=${SELECTED_NAME//,/%2C}
SELECTED_NAME=${SELECTED_NAME// /%20}

switch_to() {
  if [[ -z $TMUX ]]; then
    echo "Attaching to session: $SELECTED_NAME"
    tmux attach-session -t "=$SELECTED_NAME"
  else
    CURRENT=$(tmux display-message -p '#S')
    if [[ "$CURRENT" == "$SELECTED_NAME" ]]; then
      echo "Already in session: $SELECTED_NAME"
      return 0
    fi
    echo "Switching to session: $SELECTED_NAME"
    tmux switch-client -t "=$SELECTED_NAME"
  fi
}

if tmux has-session -t "=$SELECTED_NAME" 2> /dev/null; then
  switch_to
  exit 0
fi

echo "Creating new session: $SELECTED_NAME in $SELECTED_DIR"
tmux new-session -ds "$SELECTED_NAME" -c "$SELECTED_DIR" || exit 1

# The pane starts in $SELECTED_DIR, so tmux_init resolves the lookup order
# itself: ./.tmux_init -> ~/.tmux_init -> $DOTFILES/.tmux_init.
# send-keys needs a pane target; the trailing colon resolves the exact session
# to its active pane (a bare "=name" fails with "can't find pane").
tmux send-keys -t "=$SELECTED_NAME:" "tmux_init" C-m

switch_to
