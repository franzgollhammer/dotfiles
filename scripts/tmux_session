#!/bin/bash

# Usage: tmux_session — pick a project below ${DEV:-$HOME/dev} with fzf, then
# attach or switch to its tmux session. A missing session is created in the
# project directory and runs tmux_init. The session is named after the path
# below DEV, e.g. src/github.com/<owner>/<repo> or local/<name>.

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# dev_projects prints "<label><TAB><path>"; fzf shows the label only.
SELECTED=$("$script_dir/dev_projects" \
  | fzf --delimiter=$'\t' --with-nth=1 --prompt="Select project: " --height=40% --border)

if [[ -z "$SELECTED" ]]; then
  echo "No directory selected"
  exit 0
fi
SELECTED_NAME=${SELECTED#*$'\t'}
SELECTED_DIR=${DEV:-$HOME/dev}/$SELECTED_NAME

# tmux before 3.7 stores "." and ":" in session names as "_". That form can also
# belong to a sibling (repo.name and repo_name), so it only counts when the
# session was started in the same directory.
legacy_name=${SELECTED_NAME//[.:]/_}

# Sessions are targeted by id, because tmux splits a target at "." and ":"
# into window and pane ("=src/github.com/x" fails with "can't find pane").
SESSION_ID=
while IFS=$'\t' read -r id path name; do
  if [[ $name == "$SELECTED_NAME" ||
        ( $name == "$legacy_name" && $path == "$SELECTED_DIR" ) ]]; then
    SESSION_ID=$id
    break
  fi
done < <(tmux list-sessions -F $'#{session_id}\t#{session_path}\t#{session_name}' 2> /dev/null)

switch_to() {
  if [[ -z $TMUX ]]; then
    echo "Attaching to session: $SELECTED_NAME"
    tmux attach-session -t "$SESSION_ID"
  else
    if [[ $(tmux display-message -p '#{session_id}') == "$SESSION_ID" ]]; then
      echo "Already in session: $SELECTED_NAME"
      return 0
    fi
    echo "Switching to session: $SELECTED_NAME"
    tmux switch-client -t "$SESSION_ID"
  fi
}

if [[ -n $SESSION_ID ]]; then
  switch_to
  exit 0
fi

echo "Creating new session: $SELECTED_NAME in $SELECTED_DIR"
SESSION_ID=$(tmux new-session -dP -F '#{session_id}' -s "$SELECTED_NAME" -c "$SELECTED_DIR")
[[ -n $SESSION_ID ]] || exit 1

# The pane starts in $SELECTED_DIR, so tmux_init resolves the lookup order
# itself: ./.tmux_init -> ~/.tmux_init -> $DOTFILES/.tmux_init.
tmux send-keys -t "$SESSION_ID" "tmux_init" C-m

switch_to
