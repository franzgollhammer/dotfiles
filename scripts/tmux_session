#!/bin/bash

# Enhanced tmux session management with better error handling

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
SELECTED_PROJECT=$("$script_dir/dev_projects" | fzf --prompt="Select project: " --height=40% --border)

if [[ -z "$SELECTED_PROJECT" ]]; then
  echo "No directory selected"
  exit 0
fi
SELECTED_DIR=${DEV:-$HOME/dev}/$SELECTED_PROJECT

# Include the workspace so equal repo names in different workspaces stay distinct.
SELECTED_NAME=$(printf '%s' "$SELECTED_PROJECT" | tr "/:,. " "_____")

switch_to() {
  if [[ -z $TMUX ]]; then
    echo "Attaching to session: $SELECTED_NAME"
    tmux attach-session -t "=$SELECTED_NAME"
  else
    CURRENT=$(tmux display-message -p '#S')
    if [[ "$CURRENT" == "$SELECTED_NAME" ]]; then
      echo "Already in session: $SELECTED_NAME"
      return 0
    fi
    echo "Switching to session: $SELECTED_NAME"
    tmux switch-client -t "=$SELECTED_NAME"
  fi
}

if tmux has-session -t "=$SELECTED_NAME" 2> /dev/null; then
  switch_to
  exit 0
fi

echo "Creating new session: $SELECTED_NAME in $SELECTED_DIR"
tmux new-session -ds "$SELECTED_NAME" -c "$SELECTED_DIR" || exit 1

# The pane starts in $SELECTED_DIR, so tmux_init resolves the lookup order
# itself: ./.tmux_init -> ~/.tmux_init -> $DOTFILES/.tmux_init.
# send-keys needs a pane target; the trailing colon resolves the exact session
# to its active pane (a bare "=name" fails with "can't find pane").
tmux send-keys -t "=$SELECTED_NAME:" "tmux_init" C-m

switch_to
