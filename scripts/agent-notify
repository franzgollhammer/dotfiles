#!/bin/sh
# agent-notify — macOS desktop notification when a CLI coding agent needs input,
# finishes a turn, or errors out. Shared by claude, codex and opencode.
#
# Usage:
#   agent-notify <agent> <event> [message ...]
#
#   <agent>  claude | codex | opencode   (free-form; shown first in the title)
#   <event>  needs-input | done | error  (free-form; shown after the agent name)
#
# Codex's `notify` appends its JSON payload as a trailing argument; any argument
# starting with '{' is parsed for cwd and the assistant's last message instead of
# being treated as message text.
#
# Options:
#   --stdin       read a JSON hook payload from stdin (Claude Code / Codex hooks)
#   --pane <id>   tmux pane to report (default: $TMUX_PANE)
#   --cwd <dir>   directory to report (default: payload cwd, else $PWD)
#
# Environment:
#   AGENT_NOTIFY_ALWAYS   1 = notify on `done` even when the pane is on screen
#   AGENT_NOTIFY_LOG      append a debug line per invocation to this file
#
# The only backend is the terminal's own escape-code notification: correct icon,
# and a click focuses the terminal. Ghostty and WezTerm implement OSC 777; kitty
# implements OSC 99 instead and ignores OSC 777 entirely, so the protocol is
# picked per terminal below. iTerm2, Warp and Terminal.app do neither and will
# silently show nothing.
#
# Ghostty also drops notifications from a focused surface and rate-limits to one
# per second app-wide, so banners can go missing while it is frontmost — accepted
# trade, the osascript fallback was unclickable noise. WezTerm defaults to the
# same suppression; wezterm/wezterm.lua sets `notification_handling = AlwaysShow`
# to switch it off. kitty shows them regardless of focus (OSC 99 `o` defaults to
# `always`), so only the `done` suppression below applies there.
#
# Always exits 0 and never writes to stdout — hook stdout is a contract channel.

set -u

TITLE_MAX=63    # Ghostty caps desktop_notification.title at 63 bytes — the
BODY_MAX=255    # tightest of the supported terminals, so clip to it everywhere

log() {
	[ -n "${AGENT_NOTIFY_LOG:-}" ] || return 0
	printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$AGENT_NOTIFY_LOG" 2>/dev/null || true
}

# Strip the bytes that would break OSC 777 framing or smear across lines.
clean() { printf '%s' "$1" | tr -d '\033\007\r' | tr '\n' ' '; }
# Byte-exact truncation; LC_ALL=C makes cut count bytes, not characters.
clip() { printf '%s' "$2" | LC_ALL=C cut -c"1-$1"; }

# ── arguments ────────────────────────────────────────────────────────────────

agent='' event='' msg='' payload='' cwd='' pane="${TMUX_PANE:-}" use_stdin=0

while [ $# -gt 0 ]; do
	case $1 in
	--stdin) use_stdin=1 ;;
	--pane) shift; pane="${1:-}" ;;
	--cwd) shift; cwd="${1:-}" ;;
	-h | --help) sed -n '2,37p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
	--*) ;; # ignore unknown flags rather than failing a hook
	'{'*) payload=$1 ;;
	*)
		if [ -z "$agent" ]; then agent=$1
		elif [ -z "$event" ]; then event=$1
		else msg="${msg:+$msg }$1"
		fi
		;;
	esac
	shift
done

[ -n "$agent" ] || agent='agent'
[ -n "$event" ] || event='done'

[ "$use_stdin" -eq 1 ] && [ ! -t 0 ] && payload=$(cat 2>/dev/null || true)

# ── payload ──────────────────────────────────────────────────────────────────
# Claude Code and Codex hooks deliver snake_case JSON on stdin; Codex's `notify`
# delivers kebab-case JSON as argv. Accept every spelling and take the first hit.

if [ -n "$payload" ] && command -v jq >/dev/null 2>&1; then
	[ -n "$cwd" ] || cwd=$(printf '%s' "$payload" |
		jq -r '.cwd // empty' 2>/dev/null | head -1)
	[ -n "$msg" ] || msg=$(printf '%s' "$payload" |
		jq -r '(.message // .["last-assistant-message"] // .last_assistant_message
		        // .error // .error_details // empty)' 2>/dev/null | head -1)
fi

# ── location ─────────────────────────────────────────────────────────────────

loc='' sess='' onscreen=0
if [ -n "${TMUX:-}" ] && [ -n "$pane" ] && command -v tmux >/dev/null 2>&1; then
	# NOTE: display-message runs formats through strftime, so a literal '%' is
	# eaten — always address the pane via -t and read back #{pane_id}-free fields.
	loc=$(tmux display-message -p -t "$pane" \
		'#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null) || loc=''
	sess=$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null) || sess=''
	state=$(tmux display-message -p -t "$pane" \
		'#{window_active} #{session_attached}' 2>/dev/null) || state=''
	[ -n "$cwd" ] || cwd=$(tmux display-message -p -t "$pane" \
		'#{pane_current_path}' 2>/dev/null) || true
	case $state in
	# session_attached is a COUNT, not a boolean — >0 means some client has it.
	'1 '[1-9]*) onscreen=1 ;;
	esac
fi

[ -n "$cwd" ] || cwd=$PWD

# Worktree-safe repo name: --show-toplevel yields the branch leaf inside a
# worktree, --git-common-dir always points at the main repo's .git.
repo='' branch=''
gitdir=$(git -C "$cwd" rev-parse --git-common-dir 2>/dev/null) || gitdir=''
if [ -n "$gitdir" ]; then
	case $gitdir in /*) ;; *) gitdir="$cwd/$gitdir" ;; esac
	repo=$(basename "$(dirname "$gitdir")")
	branch=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=''
else
	repo=$(basename "$cwd")
fi

# ── frontmost app ────────────────────────────────────────────────────────────
# NOTE: this only asks "is a supported terminal frontmost", not "is it the one
# hosting this tmux client". With Ghostty, WezTerm and kitty all open the answer
# can be the wrong app; the cost is a suppressed `done` banner, so it stays simple.

front_term=0
if command -v lsappinfo >/dev/null 2>&1; then
	case $(lsappinfo info -only bundleid "$(lsappinfo front 2>/dev/null)" 2>/dev/null) in
	*com.mitchellh.ghostty* | *com.github.wez.wezterm* | *net.kovidgoyal.kitty*) front_term=1 ;;
	esac
fi

# ── suppression ──────────────────────────────────────────────────────────────
# You are looking straight at this pane, so a banner for "turn finished" is noise.
# "needs input" and "error" always fire.

case $event in
done | idle | complete | agent-turn-complete)
	if [ "$onscreen" -eq 1 ] && [ "$front_term" -eq 1 ] &&
		[ "${AGENT_NOTIFY_ALWAYS:-0}" != 1 ]; then
		log "suppress $agent/$event — pane $pane on screen"
		exit 0
	fi
	;;
esac

# ── compose ──────────────────────────────────────────────────────────────────

case $event in
needs-input | needs_input | permission | question | idle_prompt) label='braucht dich' ;;
done | idle | complete | agent-turn-complete) label='fertig' ;;
error | failure) label='Fehler' ;;
*) label=$event ;;
esac

# ';' is the OSC 777 field delimiter and may not appear in the title.
title=$(clip "$TITLE_MAX" "$(clean "$agent · $label" | tr ';' ',')")

body=$repo
[ -n "$branch" ] && body="$body @ $branch"
[ -n "$loc" ] && body="$body · $loc"
[ -n "$msg" ] && body="$body — $msg"
body=$(clip "$BODY_MAX" "$(clean "$body")")

# ── backend ──────────────────────────────────────────────────────────────────

# Write the bare OSC to the tmux CLIENT's tty, which the terminal owns directly.
# This sidesteps `allow-passthrough`, which otherwise drops sequences from any
# pane whose window is not the client's current window.
#
# Read the protocol off the ATTACHED CLIENT's terminal name, not $TERM: inside
# tmux $TERM is tmux-256color, and the value a pane inherited when it was created
# goes stale the moment the session is reattached from a different terminal.

term_tty=/dev/tty
termname="${TERM:-}"
if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
	# Prefer a client attached to THIS pane's session. With ghostty, wezterm and
	# kitty all attached to different sessions, the first client on the server is
	# frequently the wrong terminal — and then the wrong protocol too.
	client=''
	[ -n "$sess" ] && client=$(tmux list-clients -t "$sess" \
		-F '#{client_tty} #{client_termname}' 2>/dev/null | head -1)
	[ -n "$client" ] || client=$(tmux list-clients \
		-F '#{client_tty} #{client_termname}' 2>/dev/null | head -1)
	if [ -n "$client" ]; then
		term_tty=${client%% *}
		termname=${client#* }
	fi
fi

notify_osc777() { # <title> <body> — Ghostty, WezTerm
	printf '\033]777;notify;%s;%s\033\\' "$1" "$2" >"$term_tty" 2>/dev/null
}

notify_osc99() { # <title> <body> — kitty
	# One escape per field: i= groups the chunks, d=0 means "more to come", and a
	# final metadata-only chunk closes the group and raises the banner. Fields are
	# base64 (e=1) exactly like kitty's own `kitten notify`, which keeps ';' and
	# non-ASCII out of the escape code's syntax.
	# All three chunks go out in ONE write: inside tmux this tty is shared with
	# tmux's own redraws, and a group split across writes can be torn apart.
	_id="agent$$"
	_t=$(printf '%s' "$1" | base64 | tr -d '\n')
	_b=$(printf '%s' "$2" | base64 | tr -d '\n')
	printf '\033]99;i=%s:d=0:e=1;%s\033\\\033]99;i=%s:d=0:e=1:p=body;%s\033\\\033]99;i=%s;\033\\' \
		"$_id" "$_t" "$_id" "$_b" "$_id" >"$term_tty" 2>/dev/null
}

log "send $agent/$event pane=$pane onscreen=$onscreen front_term=$front_term term=$termname | $title | $body"

if [ ! -w "$term_tty" ]; then
	log "notify failed — $term_tty not writable"
	exit 0
fi

case $termname in
*kitty*) notify_osc99 "$title" "$body" || log "osc99 notify failed" ;;
*) notify_osc777 "$title" "$body" || log "osc777 notify failed" ;;
esac

exit 0
