#!/bin/bash
# Usage: dev_projects — list projects under ${DEV:-$HOME/dev} for fzf, one
# "<label><TAB><path relative to DEV>" per line.
#   src/<host>/<owner>/<repo>  ->  <owner>/<repo> (host shown unless github.com)
#   local/<name>, scratch/<name>  ->  the path itself
# Symlinks are skipped, so compatibility links never show up twice.

dev_root=${DEV:-$HOME/dev}

is_dir() {
  [ -d "$1" ] && [ ! -L "$1" ]
}

{
  for host in "$dev_root"/src/*; do
    is_dir "$host" || continue
    for owner in "$host"/*; do
      is_dir "$owner" || continue
      for repo in "$owner"/*; do
        is_dir "$repo" || continue
        label=${owner##*/}/${repo##*/}
        [ "${host##*/}" = github.com ] || label=${host##*/}/$label
        printf '%s\t%s\n' "$label" "${repo#"$dev_root"/}"
      done
    done
  done
  for group in local scratch; do
    is_dir "$dev_root/$group" || continue
    for entry in "$dev_root/$group"/*; do
      is_dir "$entry" || continue
      printf '%s\t%s\n' "$group/${entry##*/}" "$group/${entry##*/}"
    done
  done
} | LC_ALL=C sort
