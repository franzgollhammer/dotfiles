#!/bin/bash
# wt_remove - remove a worktree of the current repo (never the main one)
# Usage: wt_remove            # fzf-pick
#        wt_remove <branch>   # match by branch substring
#
# Leaves the branch itself alone - delete it with `git branch -d <branch>`.

set -euo pipefail
# shellcheck source-path=SCRIPTDIR
# shellcheck source=wt_common
source "$(dirname "$0")/wt_common"

entries=$(list_worktrees | awk -F'|' -v root="$REPO_ROOT" '$2 != root')
[[ -n "$entries" ]] || die "No removable worktrees (only the main one exists)"

if [[ -n "${1:-}" ]]; then
  selected=$(awk -F'|' -v q="$1" '$1 ~ q { print; exit }' <<< "$entries")
  [[ -n "$selected" ]] || die "No worktree matching: $1"
else
  picked=$(column -t -s '|' <<< "$entries" | fzf --prompt="Remove worktree: " --height=40% --border)
  [[ -n "$picked" ]] || exit 1
  # column pads the row, so map it back to the real entry via the branch name
  branch=$(awk '{ print $1 }' <<< "$picked")
  selected=$(awk -F'|' -v b="$branch" '$1 == b { print; exit }' <<< "$entries")
fi

branch=${selected%%|*}
path=${selected#*|}

[[ "$path" != "$CURRENT" ]] || die "You are inside that worktree - cd out first: cd $REPO_ROOT"

read -rp "Remove worktree '$branch' at $path? (y/N) " confirm
[[ "$confirm" =~ ^[Yy]$ ]] || {
  say "Cancelled"
  exit 0
}

if ! git worktree remove "$path" >&2; then
  die "Not removed - if it has uncommitted changes: git worktree remove --force '$path'"
fi

say "Removed $branch"
