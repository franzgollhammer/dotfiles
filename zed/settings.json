{
  // "icon_theme": {
  //   "mode": "system",
  //   "light": "Air + Material Icons Light",
  //   "dark": "Air + Material Icons Dark",
  // },
  // "theme": {
  //   "mode": "system",
  //   "light": "Air Light Italic",
  //   "dark": "Air Dark Italic",
  // },
  "git_panel": {
    "tree_view": true,
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "cli_default_open_behavior": "new_window",
  "agent": {
    "dock": "left",
    "thinking_display": "always_collapsed",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5",
      "enable_thinking": false,
    },
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "low",
    },
    "default_profile": "write",
    "commit_message_model": {
      "provider": "zed.dev",
      "model": "claude-haiku-4-5",
    },
  },
  "agent_servers": {
    "gemini": {
      "type": "registry",
    },
    "cursor": {
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "mode": "full-access",
      },
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "x-high",
        "mode": "bypassPermissions",
      },
      "type": "registry",
    },
  },
  "format_on_save": "off",
  "languages": {
    "Markdown": {
      "format_on_save": "on",
    },
    "JSONC": {
      "format_on_save": "on",
    },
    "JSON": {
      "format_on_save": "on",
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "format_on_save": "on",
      "formatter": [],
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "format_on_save": "on",
      "formatter": [],
    },
    "Vue.js": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "format_on_save": "on",
      "formatter": [],
    },
  },
}
