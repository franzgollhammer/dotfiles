# One Dark Theme for Ghostty
# Based on zed-industries/zed assets/themes/one/one.json (One Dark)
# Cursor and selection use Zed's local player color; selection blends
# #74ade8 at Zed's 0x3d alpha over the terminal background.

background = #282c34
foreground = #abb2bf
cursor-color = #74ade8
cursor-text = #282c34
selection-background = #3a4b5f
selection-foreground = #abb2bf

# Normal colors (0-7)
palette = 0=#282c34
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#abb2bf

# Bright colors (8-15)
palette = 8=#636d83
palette = 9=#ea858b
palette = 10=#aad581
palette = 11=#ffd885
palette = 12=#85c1ff
palette = 13=#d398eb
palette = 14=#6ed5de
palette = 15=#fafafa
