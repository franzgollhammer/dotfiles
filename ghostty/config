# install from pre-release channel
# auto-update-channel = tip

# macOS
font-thicken = true
# Preserve macOS Option character input, including Option+L for @.
macos-option-as-alt = false
# macos-icon = custom
macos-icon = official
# official
# blueprint
# chalkboard
# microchip
# glass
# holographic
# paper
# retro
# xray

# theme
theme = dark:macos-dark,light:macos-light
window-save-state = always
# background-opacity = 0.95

# font
font-feature = -calt

# keybinds
keybind = global:cmd+#=toggle_visibility

# clipboard
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# notifications (desktop notification on bell)
bell-features = audio,no-system,attention,title
bell-audio-path = /System/Library/Sounds/Bottle.aiff
# alternative macOS sounds (preview: afplay /System/Library/Sounds/<name>.aiff)
# bell-audio-path = /System/Library/Sounds/Basso.aiff
# bell-audio-path = /System/Library/Sounds/Blow.aiff
# bell-audio-path = /System/Library/Sounds/Frog.aiff
# bell-audio-path = /System/Library/Sounds/Funk.aiff
# bell-audio-path = /System/Library/Sounds/Glass.aiff
# bell-audio-path = /System/Library/Sounds/Hero.aiff
# bell-audio-path = /System/Library/Sounds/Morse.aiff
# bell-audio-path = /System/Library/Sounds/Ping.aiff
# bell-audio-path = /System/Library/Sounds/Pop.aiff
# bell-audio-path = /System/Library/Sounds/Purr.aiff
# bell-audio-path = /System/Library/Sounds/Sosumi.aiff
# bell-audio-path = /System/Library/Sounds/Submarine.aiff
# bell-audio-path = /System/Library/Sounds/Tink.aiff
bell-audio-volume = 1
desktop-notifications = true

# shell integration
shell-integration-features = no-cursor,sudo,title
