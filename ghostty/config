# install from pre-release channel
# auto-update-channel = tip

# macOS
font-thicken = true
# macos-icon = custom
# macos-custom-icon = /Users/fg/.config/ghostty/icons/ghostty-light.icns
macos-icon = official
# official
# blueprint
# chalkboard
# microchip
# glass
# holographic
# paper
# retro
# xray

# theme
theme = dark:macos-dark,light:one-light
window-padding-x = 8
window-padding-y = 6
window-save-state = always
# background-opacity = 0.95

# font
font-family = Lilex
# adjust-cell-height = 10%
# scrollback-limit = 10000

# cursor
cursor-style = block
cursor-style-blink = false

# keybinds
keybind = global:cmd+#=toggle_visibility

# clipboard
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# notifications (desktop notification on bell)
bell-features = system,attention,title
desktop-notifications = true

# shell integration
shell-integration-features = no-cursor,sudo,title
