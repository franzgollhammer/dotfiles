# install from pre-release channel
# auto-update-channel = tip

# icon
macos-icon = xray
# official
# blueprint
# chalkboard
# microchip
# glass
# holographic
# paper
# retro
# xray

# theme
theme = dark:xterm-dark,light:xterm-light
background-opacity = 0.95
# window-padding-x = 8
# window-padding-y = 8

# font
font-size = 14
font-family = Monaco Nerd Font Mono
# font-family = UbuntuMono Nerd Font Mono
# font-family = ComicShannsMono Nerd Font Mono
# font-family = JetBrainsMono Nerd Font Mono
# font-family = Lilex
# bold-color = bright
# adjust-cell-width = 5%
# adjust-cell-height = 20%

# scrollback-limit = 10000

# keybinds
keybind = global:cmd+#=toggle_visibility

# cursor
cursor-style = block
cursor-style-blink = false

# macOS
# font-thicken = true

# clipboard
# copy-on-select = clipboard
# clipboard-read = allow
# clipboard-write = allow

# mouse
# mouse-hide-while-typing = true

# window
# confirm-close-surface = false
# window-save-state = always
# window-inherit-font-size = true

# notifications (desktop notification on bell)
bell-features = system,attention,title
desktop-notifications = true

# shell integration
shell-integration-features = no-cursor,sudo,title
