# install from pre-release channel
# auto-update-channel = tip

# macOS
font-thicken = true
# Preserve macOS Option character input, including Option+L for @.
macos-option-as-alt = false
# macos-icon = custom
macos-icon = official
# official
# blueprint
# chalkboard
# microchip
# glass
# holographic
# paper
# retro
# xray

# theme
theme = dark:macos-dark,light:macos-light
window-save-state = always
# background-opacity = 0.95

# font
font-feature = -calt

# keybinds
keybind = global:cmd+#=toggle_visibility

# clipboard
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# notifications (desktop notification on bell)
bell-features = system,attention,title
desktop-notifications = true

# shell integration
shell-integration-features = no-cursor,sudo,title
