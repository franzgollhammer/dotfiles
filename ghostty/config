# install from pre-release channel
# auto-update-channel = tip

# macOS
font-thicken = true
# macos-icon = custom
# macos-custom-icon = /Users/fg/.config/ghostty/icons/ghostty-light.icns
macos-icon = official
# official
# blueprint
# chalkboard
# microchip
# glass
# holographic
# paper
# retro
# xray


# theme
theme = dark:macos-terminal-dark,light:macos-terminal-light
# background-opacity = 0.95
window-padding-x = 8
window-padding-y = 6


# font
# Matches Terminal.app's Basic profile: SF Mono Regular 13.
# font-size = 13
font-family = SFMono Nerd Font
# font-style = Regular
# adjust-cell-height = 10%
# scrollback-limit = 10000

# keybinds
keybind = global:cmd+#=toggle_visibility

# cursor
cursor-style = block
cursor-style-blink = false

# clipboard
# copy-on-select = clipboard
# clipboard-read = allow
# clipboard-write = allow

# notifications (desktop notification on bell)
bell-features = system,attention,title
desktop-notifications = true

# shell integration
shell-integration-features = no-cursor,sudo,title
